# Wyntech Campo TJMG — configuração do MVP
# Copie para .env (ou rode `npm run setup`) e troque os segredos antes de publicar.

NODE_ENV=development
# Em VPS com Nginx, mantenha 127.0.0.1 e não exponha a porta 3000.
# Use 0.0.0.0 somente se não houver proxy e o firewall proteger a porta.
HOST=127.0.0.1
PORT=3000

# Caminho do banco SQLite (relativo à raiz do projeto ou absoluto).
DB_PATH=./data/wyntech.sqlite

# Segredo HS256 dos tokens de sessão. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-este-segredo-por-uma-chave-aleatoria-de-64-caracteres

# Tempo de vida da sessão em segundos (12h por padrão).
TOKEN_TTL_SECONDS=43200

# Use true quando o site estiver em HTTPS.
COOKIE_SECURE=false

# Opcional: liberar CORS apenas para uma origem específica.
# Em produção same-origin, deixe vazio.
# CORS_ORIGIN=https://campo.seudominio.com.br

# Atalho para o Web App oficial do gerador de Laudo/Romaneio.
# Deve ser exatamente uma URL https://script.google.com/macros/s/.../exec.
# Sem essa variável, o botão do gerador fica desabilitado no console.
# OFFICIAL_LAUDO_URL=

# Proxy reverso: use true para confiar em X-Forwarded-For no rate limit.
# TRUST_PROXY=false

# Limite de tentativas de login por IP/e-mail na janela de 15 minutos.
# LOGIN_RATE_LIMIT_MAX=5

# Limite do corpo JSON em bytes (1 MB por padrão; faixa 1024..10000000).
# MAX_BODY_BYTES=1000000

# Nome do cookie de sessão (padrão wyntech_session).
# COOKIE_NAME=wyntech_session

# Em produção na VPS (Nginx na frente):
# NODE_ENV=production
# HOST=127.0.0.1
# DB_PATH=/var/lib/wyntech/wyntech.sqlite
# COOKIE_SECURE=true
# TRUST_PROXY=true
# Veja docs/producao/12-deploy-vps-1gb.md.

# Credenciais criadas pelo `npm run setup`/`npm run db:seed`.
# TROQUE AS SENHAS ANTES DE USAR COM DADOS REAIS.
SEED_ADMIN_EMAIL=admin@wyntech.local
SEED_ADMIN_PASSWORD=Wyntech@2026
SEED_TECNICO_EMAIL=tecnico@wyntech.local
SEED_TECNICO_PASSWORD=Wyntech@2026
